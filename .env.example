# Copy to backend/.env for local development. Never commit real values.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://docworkspace:docworkspace@localhost:5432/docworkspace
SESSION_SECRET=change-me-to-a-long-random-string
# JSON list of browser origins allowed for CORS and for writes (CSRF origin check).
# Production: exactly the https web origin, e.g. ["https://docworkspace-web.onrender.com"]
CORS_ORIGINS=["http://localhost:5173"]
# Seeded Alice/Bob/Charlie sign-in for local development (ADR-004). The API refuses to start
# with this set in production.
ENABLE_DEMO_AUTH=true

# Object storage — S3-compatible. Locally: moto server (`python -m moto.server -p 9000`).
# Production (Render): Cloudflare R2 endpoint, bucket document-workspace-attachments, region auto.
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=document-workspace-attachments
STORAGE_ACCESS_KEY=test
STORAGE_SECRET_KEY=test
STORAGE_REGION=us-east-1
# Local only: create the bucket on first use (never set on Render)
STORAGE_AUTO_CREATE_BUCKET=true

# Frontend: leave empty to use same-origin /api (Vite proxy locally, Render rewrite in prod)
VITE_API_BASE_URL=
